<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Planner.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:desktop="clr-namespace:Planner.Desktop;assembly=NanjingPlanner">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="Ink" Color="#44382F" />
      <SolidColorBrush x:Key="Muted" Color="#8B7867" />
      <SolidColorBrush x:Key="Accent" Color="#B76F49" />
      <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource Planner.Font.13}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Canvas}" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" />
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Theme.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="b" Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="b" Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,3,0,8" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="9">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type PasswordBox}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="9">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,3,0,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <ToggleButton Focusable="False" Background="{TemplateBinding Control.Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="9">
                        <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" Margin="10,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Popup Name="PART_Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                  <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer MaxHeight="280" CanContentScroll="True">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type DatePicker}" TargetType="{x:Type DatePicker}">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="0,3,0,8" />
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Margin" Value="3,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="Padding" Value="5" />
      </Style>
      <Style x:Key="NavigationIconButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Margin" Value="2,3" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="tile" BorderThickness="1" BorderBrush="#00FFFFFF" Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="tile" Value="{DynamicResource Theme.Hover}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="tile" Value="{DynamicResource Theme.Hover}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="tile" Value="{DynamicResource Theme.Border}" Property="Border.BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Theme.Tip}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="13" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="QuietScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource Theme.Scroll}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Grid Background="#00FFFFFF">
                <Border Name="thumb" CornerRadius="3" Background="{TemplateBinding Control.Background}" Width="4" HorizontalAlignment="Center" Opacity="0.55" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="thumb" Property="Width" Value="6" />
                  <Setter TargetName="thumb" Property="UIElement.Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="Thumb.IsDragging" Value="True">
                  <Setter TargetName="thumb" Property="Width" Value="6" />
                  <Setter TargetName="thumb" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <DataTrigger Value="Horizontal" Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}">
                  <Setter TargetName="thumb" Property="Width" Value="Auto" />
                  <Setter TargetName="thumb" Property="Height" Value="4" />
                  <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Stretch" />
                  <Setter TargetName="thumb" Property="VerticalAlignment" Value="Center" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="Horizontal" Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                    <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="thumb" Property="Height" Value="6" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="Horizontal" Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                    <Condition Value="True" Binding="{Binding IsDragging, RelativeSource={RelativeSource Self}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="thumb" Property="Height" Value="6" />
                </MultiDataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="QuietScrollPage" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="#00FFFFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Track Name="PART_Track" Orientation="{TemplateBinding ScrollBar.Orientation}" Minimum="{TemplateBinding RangeBase.Minimum}" Maximum="{TemplateBinding RangeBase.Maximum}" Value="{TemplateBinding RangeBase.Value}" ViewportSize="{TemplateBinding ScrollBar.ViewportSize}" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Name="decrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource QuietScrollPage}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Name="handle" MinHeight="24" Style="{StaticResource QuietScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Name="increase" Command="ScrollBar.PageDownCommand" Style="{StaticResource QuietScrollPage}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
                  <Setter TargetName="PART_Track" Property="Track.IsDirectionReversed" Value="False" />
                  <Setter TargetName="handle" Property="MinHeight" Value="0" />
                  <Setter TargetName="handle" Property="MinWidth" Value="24" />
                  <Setter TargetName="decrease" Property="ButtonBase.Command" Value="ScrollBar.PageLeftCommand" />
                  <Setter TargetName="increase" Property="ButtonBase.Command" Value="ScrollBar.PageRightCommand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="12" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="ContextMenu.HasDropShadow" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Control.Padding}">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Grid>
                <Border Name="item" Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="tick" Text="✓" Visibility="Collapsed" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                    <TextBlock Name="arrow" Grid.Column="2" Text="›" Margin="12,0,0,0" Visibility="Collapsed" />
                  </Grid>
                </Border>
                <Popup Name="PART_Popup" IsOpen="{TemplateBinding MenuItem.IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False">
                  <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="9" Padding="5">
                    <ItemsPresenter />
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="MenuItem.IsHighlighted" Value="True">
                  <Setter TargetName="item" Value="{DynamicResource Theme.Hover}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="MenuItem.IsChecked" Value="True">
                  <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="ItemsControl.HasItems" Value="True">
                  <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="item" Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="8,4" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>